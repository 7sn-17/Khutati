<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ draws its own splash screen before the activity exists. Left
      at the defaults it shows the launcher icon on a system-chosen surface,
      which is the blue tile users see first. Here the surface is the app's
      night colour and the icon is that same colour, so the system phase is a
      clean dark screen and the Flutter splash continues from it without a seam.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
